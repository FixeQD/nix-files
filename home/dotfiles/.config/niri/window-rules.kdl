window-rule {
    geometry-corner-radius 10
    clip-to-geometry true

    background-effect {
        blur true
    }
}

window-rule {
    match app-id=r#"^(file_progress|confirm|dialog|download|notification|error|splash|confirmreset)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Open File|branchdialog|Volume Control|Picture-in-Picture|Sharing Indicator)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(Lxappearance|pavucontrol|pavucontrol-qt|viewnior|gucharmap|file-roller|keepassxc)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(org\.gnome\.Settings|gnome-font-viewer)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(dolphin|nemo|thunar|Pcmanfm)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(wdisplays|zathura)$"#
    open-floating true
}

window-rule {
    match app-id=r#".*\.exe$"#
    open-floating true
}

window-rule {
    match app-id="^(rofi)$"
    open-floating true
}

window-rule {
    match app-id="^(wlogout)$"
    open-fullscreen true
}

window-rule {
    match title=r#"^(Volume Control)$"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    default-floating-position x=200 y=200 relative-to="top-right"
}

window-rule {
    match title="^(Sharing Indicator)$"
    default-floating-position x=0 y=0 relative-to="top-left"
}

window-rule {
    match title="^(Picture-in-Picture)$"
    open-floating true
}

window-rule {
    match app-id=r#"^(jetbrains-.*)$"# title=r#"^(win\d+)$"#
    open-focused false
}

window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|kitty|Alacritty|foot)$"#
    opacity 0.95
}

window-rule {
    match app-id="^(zeditor|Code)$"
    opacity 0.9
}

window-rule {
    match app-id=r#"^(firefox|zen-Browser)$"#
    opacity 0.9
}

window-rule {
    match app-id=r#"^(firefox|Zen Browser|chromium)$"#
    open-on-workspace "2"
}

window-rule {
    match app-id="^(Code|code-oss|zeditor)$"
    open-on-workspace "3"
}

window-rule {
    match app-id="^(discord|WebCord|vesktop)$"
    open-on-workspace "4"
}

window-rule {
    match app-id="^(Spotify|spotify)$"
    open-on-workspace "5"
}

window-rule {
    match title="^(Media viewer)$"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id="^(vmware)$"
    open-floating true
}

window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

debug {
  honor-xdg-activation-with-invalid-serial
}
